APP_NAME=caverne
SERVER_PORT=8080
APP_API_VERSION=v1

# Active Spring profiles: "default" (local dev), "prod" (production), optionally add "loki".
SPRING_PROFILES_ACTIVE=default

# Logging — see LOGGING.md for the full guide.
# Any LOGGING_LEVEL_<LOGGER>=<LEVEL> is picked up by Spring Boot at startup.
# LOGGING_LEVEL_COM_DEVIKAPPS_CAVERNE=DEBUG
# LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=DEBUG
# LOGGING_LEVEL_HTTP_ACCESS=INFO
# LOGGING_LEVEL_ORG_HIBERNATE_SQL=DEBUG

# Optional Grafana Loki appender — activate by appending "loki" to SPRING_PROFILES_ACTIVE.
# LOKI_URL=https://logs-prod-xxx.grafana.net/loki/api/v1/push
# LOKI_USER=
# LOKI_PASSWORD=
# LOKI_ENV=prod

# PostgreSQL datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/caverne
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_DOCKER_COMPOSE_ENABLED=false

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=true
SPRING_JPA_PROPERTIES_HIBERNATE_FORMAT_SQL=true

# CORS
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
APP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin
APP_CORS_EXPOSED_HEADERS=Location
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_MAX_AGE=3600

# Catalog niches import
CATALOG_NICHES_IMPORT_ENABLED=false
CATALOG_NICHES_IMPORT_PATH=niches.md

# Auth providers
AUTH_PROVIDERS_SUPABASE_ENABLED=false
AUTH_PROVIDERS_SUPABASE_URL=https://project-ref.supabase.co
AUTH_PROVIDERS_SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
AUTH_PROVIDERS_SUPABASE_JWT_SECRET=super-secret-jwt-key
AUTH_PROVIDERS_SUPABASE_ISSUER=https://project-ref.supabase.co/auth/v1
AUTH_PROVIDERS_SUPABASE_AUDIENCE=authenticated
AUTH_PROVIDERS_SUPABASE_WEBHOOK_SECRET=replace_with_supabase_webhook_shared_secret

# Initial admin bootstrap
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_FIRSTNAME=Initial
BOOTSTRAP_ADMIN_LASTNAME=Admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# Manual payment (bank transfer)
MANUAL_ENABLED=false

# Stripe
STRIPE_ENABLED=false
STRIPE_API_KEY=sk_test_example
STRIPE_API_VERSION=2024-06-20
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3000/checkout/cancel
STRIPE_WEBHOOK_SECRET=whsec_example

## it's only in test
RUN_REAL_STRIPE_TEST=true
