<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">

  <!--
    Masquage des données sensibles.
    Deux passes via %replace (chaînées):
      1) key=value / key:value / key "value" pour password, token, secret, api_key, etc.
      2) Bearer <jeton>.
    La valeur matchée est remplacée par "***". Appliqué au message AVANT sérialisation,
    en dev (pattern) comme en prod (JSON).
  -->

  <!-- =============================== PROFIL DEV / LOCAL / DEFAULT =============================== -->
  <springProfile name="dev,local,default">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{36}) traceId=%X{traceId:-} userId=%X{userId:-} - %replace(%replace(%msg){'(?i)(Bearer\s+)\S+', '$1***'}){'(?i)(password|passwd|pwd|secret|token|access[_-]?token|refresh[_-]?token|api[_-]?key|authorization)(\s*[=:]\s*)\S+', '$1$2***'}%n%rEx</pattern>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
    <logger name="com.devikapps.caverne" level="DEBUG"/>
  </springProfile>

  <!-- =============================== PROFIL PROD =============================== -->
  <springProfile name="prod">
    <appender name="JSON_STDOUT" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
        <providers>
          <timestamp>
            <fieldName>timestamp</fieldName>
            <timeZone>UTC</timeZone>
            <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
          </timestamp>
          <version><fieldName>schemaVersion</fieldName></version>
          <logLevel><fieldName>level</fieldName></logLevel>
          <loggerName>
            <fieldName>logger</fieldName>
            <shortenedLoggerNameLength>40</shortenedLoggerNameLength>
          </loggerName>
          <threadName><fieldName>thread</fieldName></threadName>
          <mdc>
            <fieldName>mdc</fieldName>
          </mdc>
          <stackTrace>
            <fieldName>stackTrace</fieldName>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
              <maxDepthPerThrowable>40</maxDepthPerThrowable>
              <maxLength>8192</maxLength>
              <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
          </stackTrace>
          <!-- Champs statiques + message masqué. -->
          <pattern>
            <pattern>
              {
                "app": "${spring.application.name:-caverne}",
                "env": "prod",
                "message": "%replace(%replace(%msg){'(?i)(Bearer\\s+)\\S+', '$1***'}){'(?i)(password|passwd|pwd|secret|token|access[_-]?token|refresh[_-]?token|api[_-]?key|authorization)(\\s*[=:]\\s*)\\S+', '$1$2***'}"
              }
            </pattern>
          </pattern>
        </providers>
      </encoder>
    </appender>

    <root level="INFO">
      <appender-ref ref="JSON_STDOUT"/>
    </root>

    <!-- Niveaux par défaut en prod: surchargeables via env LOGGING_LEVEL_* -->
    <logger name="com.devikapps.caverne" level="INFO"/>
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
    <logger name="org.springframework.web" level="INFO"/>
  </springProfile>

  <!--
    Appender Loki optionnel. Activer en ajoutant "loki" à SPRING_PROFILES_ACTIVE
    (ex: SPRING_PROFILES_ACTIVE=prod,loki) et en définissant LOKI_URL (+ LOKI_USER /
    LOKI_PASSWORD si le tenant en a besoin). L'appender s'ajoute aux appenders déjà
    en place (JSON_STDOUT pour prod, CONSOLE pour dev) — les logs partent aux deux endroits.
  -->
  <springProfile name="loki">
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
      <http>
        <url>${LOKI_URL}</url>
        <auth>
          <username>${LOKI_USER:-}</username>
          <password>${LOKI_PASSWORD:-}</password>
        </auth>
      </http>
      <format>
        <label>
          <pattern>app=caverne,env=${LOKI_ENV:-prod},level=%level,logger=%logger{20}</pattern>
          <readMarkers>true</readMarkers>
        </label>
        <message class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
          <providers>
            <timestamp>
              <fieldName>timestamp</fieldName>
              <timeZone>UTC</timeZone>
              <pattern>yyyy-MM-dd'T'HH:mm:ss.SSSXXX</pattern>
            </timestamp>
            <logLevel><fieldName>level</fieldName></logLevel>
            <loggerName><fieldName>logger</fieldName></loggerName>
            <threadName><fieldName>thread</fieldName></threadName>
            <mdc><fieldName>mdc</fieldName></mdc>
            <stackTrace>
              <fieldName>stackTrace</fieldName>
              <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                <maxDepthPerThrowable>40</maxDepthPerThrowable>
                <maxLength>8192</maxLength>
                <rootCauseFirst>true</rootCauseFirst>
              </throwableConverter>
            </stackTrace>
            <pattern>
              <pattern>
                {
                  "message": "%replace(%replace(%msg){'(?i)(Bearer\\s+)\\S+', '$1***'}){'(?i)(password|passwd|pwd|secret|token|access[_-]?token|refresh[_-]?token|api[_-]?key|authorization)(\\s*[=:]\\s*)\\S+', '$1$2***'}"
                }
              </pattern>
            </pattern>
          </providers>
        </message>
      </format>
      <batchMaxItems>500</batchMaxItems>
      <batchTimeoutMs>10000</batchTimeoutMs>
    </appender>

    <root level="INFO">
      <appender-ref ref="LOKI"/>
    </root>
  </springProfile>

</configuration>
